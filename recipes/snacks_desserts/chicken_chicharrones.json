{
    "filename": "chicken_chicharrones.json",
    "name": "香脆雞皮脆片（高蛋白減脂點心）",
    "description": "酥脆高蛋白的零食替代選擇，使用雞胸肉搭配調味料烘烤與氣炸而成。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "tags": [
        "西式",
        "雞肉",
        "點心",
        "低碳",
        "高蛋白"
    ],
    "ingredients": [
        {
            "name": "雞胸肉",
            "quantity": 350,
            "unit": "g"
        },
        {
            "name": "紅椒粉",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "大蒜粉",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "黑胡椒",
            "quantity": 2,
            "unit": "g"
        },
        {
            "name": "泡打粉",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "酪梨油噴霧",
            "quantity": 5,
            "unit": "g"
        }
    ],
    "steps": [
        "將中型雞胸肉切成薄片或處理至極薄，鋪平於烤盤上。",
        "均勻撒上紅椒粉、大蒜粉、鹽、黑胡椒與泡打粉，確保每片雞肉皆沾附調味料。",
        "放入預熱至 180°C 的烤箱中烘烤 35 至 40 分鐘（中途可使用酪梨油噴霧噴灑表面）。",
        "取出後放入氣炸鍋中，以 200°C 氣炸 5 至 6 分鐘。",
        "出爐後靜置冷散熱 5 至 10 分鐘，即可變得酥脆享用。"
    ],
    "notes": [
        "食材重量估算：2 塊中型雞胸肉約為 350g。",
        "確保食材鋪得越薄越好，否則烘烤時將無法達到酥脆口感。",
        "成品會在冷卻過程中變得更加酥脆，請務必在通風處靜置 5 至 10 分鐘後再食用。"
    ]
}
