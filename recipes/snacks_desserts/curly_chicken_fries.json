{
    "filename": "curly_chicken_fries.json",
    "name": "脆皮零碳水雞肉曲曲薯條",
    "description": "這是一款利用雞絞肉製作的低碳水點心，口感酥脆且充滿辛香料香氣，外型如同曲曲薯條般有趣，是生酮飲食者的絕佳零嘴。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 30,
    "tags": [
        "雞肉",
        "點心",
        "低碳",
        "烤箱"
    ],
    "ingredients": [
        {
            "name": "雞絞肉",
            "quantity": 454,
            "unit": "g",
            "note": "瘦肉"
        },
        {
            "name": "雞蛋",
            "quantity": 100,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "黑胡椒",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "紅椒粉",
            "quantity": 2,
            "unit": "g"
        },
        {
            "name": "大蒜粉",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "洋蔥粉",
            "quantity": 3,
            "unit": "g"
        }
    ],
    "steps": [
        "將雞絞肉、雞蛋、鹽、黑胡椒、紅椒粉、大蒜粉與洋蔥粉放入碗中充分混合均勻。",
        "將混合好的肉泥裝入夾鏈袋中。",
        "在烤盤上鋪好防沾烤紙並塗上薄薄一層油。在夾鏈袋的一角剪開一個微小開口。",
        "將肉泥以擠花方式，在烤盤上擠出捲曲的長條狀。",
        "放入預熱至 200°C (400°F) 的烤箱中烘烤約 20 分鐘，直到表面呈現金黃酥脆狀即可。"
    ],
    "notes": [
        "重量換算：1 lb 換算為 454 g。",
        "雞蛋：1 顆約為 50 g，本食譜使用 2 顆共計 100 g。",
        "單位換算：1 tsp 辛香料根據密度估算約為 2-3 g。",
        "鹽與黑胡椒：原食譜為「適量」，已依據肉量比例換算為具體數值。",
        "變化做法：可額外加入約 100 g 的帕瑪森起司粉並塑形成塊狀，即可製作成低碳雞塊。",
        "烘烤溫度：400°F 約等於 200°C。"
    ]
}