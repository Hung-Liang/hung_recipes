{
    "filename": "air_fryer_seasoned_steamed_eggs.json",
    "name": "氣炸醬香蒸蛋",
    "description": "使用氣炸鍋快速完成的家常醬香蒸蛋，口感滑嫩且香氣濃郁。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 15,
    "tags": [
        "中式",
        "蔬食",
        "氣炸鍋",
        "懶人料理"
    ],
    "ingredients": [
        {
            "name": "雞蛋",
            "quantity": 150,
            "unit": "g"
        },
        {
            "name": "醬油",
            "quantity": 45,
            "unit": "ml"
        },
        {
            "name": "香油",
            "quantity": 22.5,
            "unit": "ml"
        },
        {
            "name": "水",
            "quantity": 30,
            "unit": "ml"
        },
        {
            "name": "白芝麻",
            "quantity": 2,
            "unit": "g"
        }
    ],
    "steps": [
        "將 3 顆雞蛋打入耐熱調理碗中均勻打散。",
        "加入醬油 45 ml、香油 22.5 ml 與水 30 ml，攪拌混合均勻。",
        "在蛋液表面撒上適量白芝麻點綴增香。",
        "將調理碗放入氣炸鍋中，以 160°C 氣炸烘烤 10 分鐘至蛋液完全凝固即可出鍋。"
    ],
    "notes": [
        "雞蛋：以 1 顆中型雞蛋約 50 g 計算，3 顆總計約 150 g。",
        "白芝麻：估算約 2 g。",
        "湯匙單位已換算為標準容量（1 湯匙 = 15 ml）。"
    ]
}
