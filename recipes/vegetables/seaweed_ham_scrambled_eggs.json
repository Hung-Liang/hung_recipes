{
    "name": "紫菜火腿炒蛋",
    "description": "將紫菜炒乾揉碎，搭配炒散的雞蛋與火腿丁，是一道簡單又充滿海味的家常快炒。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 10,
    "tags": [
        "中式",
        "豬肉",
        "一鍋到底"
    ],
    "ingredients": [
        {
            "name": "紫菜",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "雞蛋",
            "quantity": 100,
            "unit": "g"
        },
        {
            "name": "火腿丁",
            "quantity": 50,
            "unit": "g"
        },
