{
    "filename": "universal_sesame_sauce.json",
    "name": "萬能麻醬汁",
    "description": "香氣濃郁的萬用麻醬汁，作法簡單，非常適合用來拌麵或作為各種料理的沾醬。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
