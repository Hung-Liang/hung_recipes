            "unit": "g"
        },
        {
            "name": "蒜末",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "辣椒粉",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "白芝麻",
            "quantity": 5,
            "unit": "g"
        },
        {
