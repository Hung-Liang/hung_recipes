        "主食",
        "電鍋"
    ],
    "ingredients": [
        {
            "name": "豬絞肉",
            "quantity": 200,
            "unit": "g"
        },
        {
            "name": "蔥花",
            "quantity": 20,
            "unit": "g"
        },
        {
            "name": "薑末",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "蒜末",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "醬油",
            "quantity": 25,
            "unit": "ml"
        },
        {
            "name": "麻油",
            "quantity": 10,
            "unit": "ml"
        },
        {
            "name": "餛飩皮",
            "quantity": 80,
            "unit": "g"
        },
        {
            "name": "食用油",
            "quantity": 5,
            "unit": "ml"
        },
        {
            "name": "辣椒醬",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "蔥酥",
            "quantity": 10,
            "unit": "g"
        }
    ],
    "steps": [
        "碗中放入絞肉、蔥花、薑末與蒜末。",
        "加入醬油與麻油調味，抓拌均勻。",
        "準備一個可蒸的烤皿或深盤，先在底部刷上一層食用油。",
        "最底層鋪上一層餛飩皮。",
        "在餛飩皮上薄薄鋪一層肉餡。",
        "重複「餛飩皮 → 肉餡」的順序往上疊，每層肉餡不要太厚。",
        "最上層再蓋一層餛飩皮。",
        "放入蒸鍋，蒸約 20 分鐘。",
        "起鍋後淋上醬油、麻油與辣椒醬。",
        "最後撒上蔥酥與蔥花即可。"
    ],
    "notes": [
        "本食譜依據常理估算單人份量，所有未標明用量的食材皆已換算為公克（g）與毫升（ml）。",
        "餛飩皮：預估約需 10 片，總重估算為 80 g。",
        "醬油與麻油的用量包含了醃製絞肉以及最後的淋醬，可依個人口味自行增減。"
    ]
}
