{
    "filename": "white_sauce_chicken_protein_pasta.json",
    "name": "白醬雞肉高蛋白義大利麵",
    "description": "這是一道以高蛋白牛奶與起司濃湯包為基底的白醬義大利麵，搭配去皮雞腿肉，適合健身與日常的高蛋白料理。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 25,
    "tags": [
        "西式",
        "澱粉",
        "雞肉",
        "主食",
        "高蛋白"
    ],
    "ingredients": [
        {
            "name": "高蛋白義大利麵",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "去皮雞腿肉",
            "quantity": 85,
            "unit": "g"
        },
        {
            "name": "高蛋白牛奶",
            "quantity": 100,
            "unit": "ml"
        },
        {
            "name": "起司濃湯包",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "洋蔥",
            "quantity": 40,
            "unit": "g"
        },
        {
            "name": "蘑菇",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "蒜末",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "橄欖油",
            "quantity": 5,
            "unit": "ml"
        },
        {
            "name": "帕馬森起司粉",
            "quantity": 5,
            "unit": "g"
        }
    ],
    "steps": [
        "煮高蛋白義大利麵（同時進行步驟 2 至 5）。",
        "鍋中倒入橄欖油，加入洋蔥與蒜末炒香。",
        "放入蘑菇與雞腿肉拌炒至雞肉半熟。",
        "倒入高蛋白牛奶，蓋上鍋蓋燜煮約 4 分鐘。",
        "加入起司濃湯粉拌勻，煮到醬汁稍微變濃。",
        "放入煮好的高蛋白義大利麵一起拌勻。",
        "起鍋後撒上帕馬森起司粉即可。"
    ],
    "notes": [
        "起司濃湯包：市售濃湯包半包約估算為 10 g。",
        "洋蔥：1/4 顆約估算為 40 g。",
        "蘑菇：適量估算為 50 g。",
        "蒜末：少許估算為 5 g（約一瓣）。",
        "橄欖油：少量估算為 5 ml。",
        "帕馬森起司粉：少許估算為 5 g。",
        "營養標示（每份預估）：約 425–445 kcal、蛋白質 43 g、碳水化合物 33 g、脂肪 16 g。"
    ]
}
