{
    "name": "紅油牛肉餛飩",
    "description": "鮮嫩多汁的牛肉餛飩拌入香辣開胃的紅油醬汁，口感豐富且具有層次感。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 40,
    "tags": [
        "中式",
        "牛肉",
        "澱粉"
    ],
    "ingredients": [
        {
            "name": "牛絞肉",
            "quantity": 200,
            "unit": "g"
        },
        {
            "name": "餛飩皮",
            "quantity": 100,
            "unit": "g"
        },
        {
            "name": "大蒜",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "生薑",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "醬油",
            "quantity": 30,
            "unit": "ml"
        },
        {
            "name": "芝麻油",
            "quantity": 5,
            "unit": "ml"
        },
        {
            "name": "青蔥",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "胡椒粉",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "辣油",
            "quantity": 15,
