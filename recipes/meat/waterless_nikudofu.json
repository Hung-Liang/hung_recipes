        "懶人料理"
    ],
    "ingredients": [
        {
            "name": "豬肉片",
            "quantity": 250,
            "unit": "g"
        },
        {
            "name": "豆腐",
            "quantity": 300,
            "unit": "g"
        },
        {
            "name": "洋蔥",
            "quantity": 500,
            "unit": "g"
        },
        {
            "name": "鹽昆布",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "青蔥",
            "quantity": 30,
