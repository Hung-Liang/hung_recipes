            "quantity": 150,
            "unit": "g"
        },
        {
            "name": "板豆腐",
            "quantity": 300,
            "unit": "g"
        },
        {
            "name": "醬油",
            "quantity": 25,
            "unit": "g"
        },
        {
            "name": "蠔油",
