{
    "name": "家常紅燒雞腿",
    "description": "醬香濃郁，下飯一流的家常菜。",
    "servings": {
        "quantity": 2,
        "unit": "份"
    },
    "totalTime": 35,
    "tags": [
        "中式",
        "雞肉",
        "紅燒"
    ],
    "ingredients": [
        {
            "name": "雞腿",
            "quantity": 500,
            "unit": "g"
        },
        {
            "name": "醬油",
            "quantity": 50,
            "unit": "ml"
        },
        {
            "name": "米酒",
            "quantity": 20,
            "unit": "ml"
        },
        {
            "name": "冰糖",
            "quantity": 10,
            "unit": "g"
        },
        {
            "name": "薑片",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "水",
            "quantity": 300,
            "unit": "ml"
        }
    ],
    "steps": [
        "將雞腿洗淨，切塊後用熱水汆燙去腥。",
        "熱鍋，放入雞腿煎至表面金黃。",
        "加入薑片、醬油、米酒、冰糖和水，煮滾後轉小火。",
        "蓋上鍋蓋，燜煮約 20 分鐘，直到雞腿入味且湯汁濃稠即可。"
    ],
    "notes": [
        "可依個人口味調整醬油和糖的用量。",
        "若湯汁不夠，可適當加水。",
        "雞腿：2 支約為 500 g。",
        "水：根據燜煮需求，智慧估算基本水量為 300 ml。"
    ]
}