{
    "filename": "orleans_marinated_chicken_breast.json",
    "name": "奧爾良嫩煎雞胸肉",
    "description": "利用小蘇打與玉米澱粉醃漬軟化的低脂嫩雞胸肉，適合批次製作並冷凍保存，退冰後薄油煎熟即可享用。",
    "servings": {
        "quantity": 6,
        "unit": "份"
    },
    "totalTime": 490,
    "tags": [
        "西式",
        "雞肉",
        "低碳",
        "高蛋白",
        "懶人料理"
    ],
    "ingredients": [
        {
            "name": "雞胸肉",
            "quantity": 1200,
            "unit": "g"
        },
        {
            "name": "小蘇打粉",
            "quantity": 7,
            "unit": "g"
        },
        {
            "name": "蒜粉",
            "quantity": 2,
            "unit": "g"
        },
        {
            "name": "白胡椒粉",
            "quantity": 0.5,
            "unit": "g"
        },
        {
            "name": "味精",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "奧爾良烤肉粉",
            "quantity": 20,
            "unit": "g"
        },
        {
            "name": "洋蔥粉",
            "quantity": 2,
            "unit": "g"
        },
        {
            "name": "玉米澱粉",
            "quantity": 90,
            "unit": "g"
        },
        {
            "name": "水",
            "quantity": 250,
            "unit": "ml"
        },
        {
            "name": "食用油",
            "quantity": 10,
            "unit": "ml"
        }
    ],
    "steps": [
        "將雞胸肉去除表面多餘脂肪與筋膜，橫切片成三等分薄片備用。",
        "將雞胸肉片置於調理盆中，加入小蘇打粉、蒜粉、白胡椒粉、味精、鹽、奧爾良烤肉粉、洋蔥粉、玉米澱粉與水。",
        "充分抓醃按摩雞胸肉，直至水分與調粉完全被肉質吸收。",
        "加蓋或封上保鮮膜，放入冷藏室醃漬過夜使肉質軟化入味。",
        "將醃漬完成的雞胸肉依單次食用分量分裝，放入冷凍庫保存。",
        "食用前提前移至冷藏退冰，平底鍋倒入少許食用油以中小火熱鍋，將雞胸肉雙面煎至全熟微金黃即可起鍋。"
    ],
    "notes": [
        "份量說明：以 1200 g 雞胸肉估算，約可分為 6 份常備分量（每份約 200 g）。",
        "煎製用油：煎製步驟估算使用約 10 ml 烹調用油薄煎。",
        "保存與加熱建議：冷凍保存建議在 1 個月內食用完畢；煎製時注意火候，熟透即可起鍋以保持軟嫩多汁。"
    ]
}
