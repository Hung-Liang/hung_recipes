{
    "filename": "zero_carb_chicken_nuggets.json",
    "name": "零碳水雞塊",
    "description": "高蛋白、幾乎零碳水化合物的酥脆雞塊，使用豬皮碎增加酥脆口感，非常適合減脂與生酮飲食。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "tags": [
        "雞肉",
        "點心",
        "低碳",
        "氣炸鍋",
        "高蛋白"
    ],
    "ingredients": [
        {
            "name": "雞胸肉",
            "quantity": 250,
            "unit": "g"
        },
        {
            "name": "豬皮碎",
            "quantity": 30,
            "unit": "g"
        },
        {
            "name": "雞蛋",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "大蒜粉",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "洋蔥粉",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "乾燥洋香菜",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "黑胡椒",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 2,
            "unit": "g"
        },
        {
            "name": "紅椒粉",
            "quantity": 1,
            "unit": "g"
        }
    ],
    "steps": [
        "將雞胸肉切成小塊。",
        "將雞胸肉、豬皮碎、雞蛋以及大蒜粉、洋蔥粉、乾燥洋香菜、黑胡椒、鹽、紅椒粉等所有調味料放入食物調理機中，攪拌打成均勻的肉泥。",
        "將打好的肉泥分成數等份，用手捏成厚度均勻的雞塊形狀。",
        "放入氣炸鍋中，以 200°C 氣炸約 10 至 12 分鐘，或直到表面金黃酥脆且內部完全熟透即可享用。"
    ],
    "notes": [
        "雞蛋：1 顆大雞蛋約估算為 50 g。",
        "粉狀調味料：1 茶匙的大蒜粉與洋蔥粉約估計為 3 g；乾燥洋香菜、黑胡椒與紅椒粉等較輕的香料約估計為 1 g。",
        "鹽量：原食譜指示為『適量』，為達標準化，在此預設為 2 g（約半茶匙），可依個人口味微調。",
        "保存與復熱：剩餘雞塊可冷藏保存約 3 天，食用前建議使用氣炸鍋或烤箱稍微加熱，以恢復表皮的酥脆感。"
    ]
}
