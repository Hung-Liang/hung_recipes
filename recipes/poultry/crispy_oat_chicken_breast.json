{
    "filename": "crispy_oat_chicken_breast.json",
    "name": "燕麥酥炸雞胸肉",
    "description": "使用氣炸鍋製作的健康低脂燕麥酥炸雞胸肉，外酥內嫩，適合作為減脂期的高蛋白料理。",
    "servings": {
        "quantity": 1,
        "unit": "份"
    },
    "totalTime": 40,
    "tags": [
        "雞肉",
        "氣炸鍋",
        "高蛋白"
    ],
    "ingredients": [
        {
            "name": "雞胸肉",
            "quantity": 300,
            "unit": "g"
        },
        {
            "name": "鹽",
            "quantity": 3,
            "unit": "g"
        },
        {
            "name": "黑胡椒",
            "quantity": 1,
            "unit": "g"
        },
        {
            "name": "醬油膏",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "雞蛋",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "燕麥片",
            "quantity": 40,
            "unit": "g"
        }
    ],
    "steps": [
        "將雞胸肉切成適口大小的塊狀。",
        "加入鹽、黑胡椒與醬油膏抓勻醃製。",
        "打入一顆雞蛋拌勻，讓雞肉表面附著蛋液。",
        "將雞肉均勻裹上一層燕麥片。",
        "放入氣炸鍋中，以 180 度烘烤 15 分鐘。",
        "取出翻面後，再以 180 度烘烤 10 分鐘至表面金黃酥脆即可。"
    ],
    "notes": [
        "雞蛋：1 顆約為 50 g。",
        "可依個人口味調整醃製時間或增減黑胡椒用量。"
    ]
}
