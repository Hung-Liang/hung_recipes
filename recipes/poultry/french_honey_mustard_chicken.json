        "西式",
        "雞肉",
        "氣炸鍋",
        "烤箱"
    ],
    "ingredients": [
        {
            "name": "無骨雞腿",
            "quantity": 600,
            "unit": "g"
        },
        {
            "name": "法式芥末",
            "quantity": 60,
            "unit": "g"
        },
        {
            "name": "蜂蜜",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "食用油",
            "quantity": 45,
            "unit": "g"
        },
        {
            "name": "醋",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "鹽巴",
            "quantity": 4,
            "unit": "g"
        },
        {
            "name": "蒜頭",
            "quantity": 15,
            "unit": "g"
        },
        {
            "name": "黑胡椒",
            "quantity": 2,
            "unit": "g"
        }
    ],
    "steps": [
        "將所有材料充分攪拌均勻製成黃色濃稠的醃料，放入冰箱將無骨雞腿醃製最少 30 分鐘（亦可冷藏醃製一晚）；可使用其他芥末醬，但請避免使用原粒芥末籽醬（whole grain mustard）。",
        "將雞腿皮朝上擺放，氣炸鍋以 200 度烘烤約 15 分鐘，中途須將雞腿上下翻面；若使用烤箱或焗爐，則以 220 度烘烤約 15 至 20 分鐘。",
        "將帶皮的一側烤至微微焦香風味更佳，出爐後若覺得鹹度不足可再自行撒上適量鹽巴。"
    ],
    "notes": [
        "無骨雞腿 3-4 塊約為 600 g，蒜頭 2-3 顆約為 15 g。",
        "若使用其他芥末醬，請避免使用含有原粒芥末籽的款式。"
    ]
}
