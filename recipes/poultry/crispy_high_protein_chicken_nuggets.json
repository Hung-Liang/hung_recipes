    "name": "酥脆高蛋白雞塊",
    "description": "這是一款無需油炸的酥脆高蛋白雞塊，外層使用米紙包裹以增加酥脆口感。整份食譜可製作 30 塊，是減脂期絕佳的點心或主食選擇。",
    "servings": {
        "quantity": 30,
        "unit": "塊"
    },
    "tags": [
        "雞肉",
        "點心",
        "低碳",
        "氣炸鍋",
        "高蛋白"
    ],
    "ingredients": [
        {
            "name": "低脂雞絞肉",
            "quantity": 500,
            "unit": "g"
        },
        {
            "name": "雞蛋",
            "quantity": 50,
            "unit": "g"
        },
        {
            "name": "洋蔥粉",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "大蒜粉",
            "quantity": 5,
            "unit": "g"
        },
        {
            "name": "煙燻紅椒粉",
            "quantity": 5,
            "unit": "g"
        },
        {
